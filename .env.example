# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local preview: leave NEXT_PUBLIC_SUPABASE_URL unset to keep demo-cookie login.
# Production (https://flexible-labels.vercel.app): set both URL + ANON_KEY.
# Then flg_demo_session is ignored. Auth doors:
#   /portal/login      customers
#   /operations/login  employees (profiles.role = employee)
#
# Supabase Auth settings (Dashboard → Authentication → URL configuration):
#   Site URL: https://flexible-labels.vercel.app
#   Redirect allow list:
#     https://flexible-labels.vercel.app/portal/login
#     https://flexible-labels.vercel.app/operations/login

# AI document parsing (optional — demo uses rule-based parser without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Vercel deployment: link repo and add env vars in project settings
