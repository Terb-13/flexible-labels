# Supabase — create a project at https://supabase.com
# No secrets belong in git. Copy to .env.local for local work.
# Vercel: add the same three names in project environment settings.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — demo RFP parse is rule-based and does not need these
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
